namespace SemiringCongruence'

variable (R : Type*) [Semiring R]

structure RingReflSymm where
  r : R → R → Prop
  refl : ∀ a, r a a
  symm : ∀ {a b}, r a b → r b a
  add : ∀ {a b c d}, r a b → r c d → r (a + c) (b + d)
  mul : ∀ {a b c d}, r a b → r c d → r (a * c) (b * d)

