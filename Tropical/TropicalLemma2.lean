variable {R}
-- これを入れないとC : RingReflSymm R のTypeが Type u+1 と Type (?u.15456 + 1) で
-- 一致しないと怒られる.

-- コメントの変数はexpose_namesで展開されたものではなく記述している場合がある
theorem transGen_add (C : RingReflSymm R)
    {a b a' b' : R} (h : TransGen C.r a b) (h' : TransGen C.r a' b') :
    TransGen C.r (a + a') (b + b') := by
  -- h : TransGen C.r a b
  induction h
  -- h => b_1 : R
  --      h : C.r a b_1
    -- h' : TransGen C.r a' b'
  · induction h'
    -- h' => b_2 : R
    --       h_1 : C.r a' b_2
    · expose_names
      apply TransGen.single (C.add h h_1)
    -- h =>  b_1 : R
    --       h : C.r a b_1
    -- h' => b_2 c : R
    --       h_1 : TransGen C.r a' b_2
    --       h_2 : C.r b_2 c
    --       a_ih : TransGen C.r (a + a') (b_1 + b_2)
    · expose_names
      apply TransGen.tail a_ih (C.add (C.refl b_1) h_2)
  -- h' : TransGen C.r a' b'
  -- h => b_1 c : R
  --      h : TransGen C.r a b_1
  --      h_1 : C.r b_1 c
  --      a_ih : TransGen C.r (a + a') (b_1 + b')
  · expose_names
    apply TransGen.trans a_ih (TransGen.single (C.add h_1 (C.refl b')))

theorem transGen_mul (C : RingReflSymm R)
    {a b a' b' : R} (h : TransGen C.r a b) (h' : TransGen C.r a' b') :
    TransGen C.r (a * a') (b * b') := by
  induction h
  · induction h'
    · expose_names
      apply TransGen.single (C.mul h h_1)
    · expose_names
      apply TransGen.tail a_ih (C.mul (C.refl b_1) h_2)
  · expose_names
    apply TransGen.trans a_ih (TransGen.single (C.mul h_1 (C.refl b')))

def chainCon (C : RingReflSymm R) : RingCon R where
  r := TransGen C.r
  iseqv :=
    { refl := fun a => TransGen.single (C.refl a)
      symm := fun h => sorry
      trans := fun h h' => h.trans h' }
  mul' := fun h h' => transGen_mul C h h'
  add' := fun h h' => transGen_add C h h'


theorem ringConGen_eq_TransGen (C : RingReflSymm R) (f g : R) :
    ringConGen C.r f g ↔ TransGen C.r f g := by
  constructor
  · sorry
  · sorry

end SemiringCongruence'
